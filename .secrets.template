# Copy to ../.secrets, one directory above the web root (true-og/.secrets on the server), so nginx can never serve it. One key=value per line.
# The Discord webhook the application forms post to. The forms show as closed until it is set.
discord_webhook=https://discord.com/api/webhooks/<id>/<token>
# Where applications are appended while Discord is down. Optional: the default is ../databases/applications.txt next to this file. Must be writable by PHP; stops at 5 MB.
# applications_file=/srv/true-og/databases/applications.txt
